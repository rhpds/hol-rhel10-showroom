[rhel10_nodes]
node1
node2
node3

[leapp_nodes]
leapp

[bastions]
bastion

[bastions:vars]
ansible_host="{{ lookup('env', 'BASTION_SSH_HOSTNAME') | default('ssh.ocpvdev01.rhdp.net') }}"
ansible_port="{{ lookup('env', 'BASTION_SSH_PORT') | default(32461) | int }}"

[all:vars]
ansible_user="{{ lookup('env', 'USER') | default('lab-user') }}"
ansible_ssh_private_key_file=/app/.ssh/id_rsa
ansible_ssh_common_args="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

